# Copy to .env (git-ignored) or let ./setup.sh create it.
SERVICE_NAME=demo-app

# Jenkins API access (read-only use: builds, stages, tests, console).
# Create a token in Jenkins: user menu > Security > API Token > Add new token.
JENKINS_URL=http://10.20.1.10:8080
JENKINS_USER=admin
JENKINS_TOKEN=

# Optional shared secret for POST /api/events/*, /api/alerts/* and recovery results
# (header X-Platform-Token). If you set it, also set PLATFORM_INGEST_TOKEN in jenkins/.env
# and add the header to Alertmanager's webhook config.
INGEST_TOKEN=

# Recovery approvals. The Jenkins user above needs permission to build the "recovery" job.
# Approvers must enter this secret (leave empty to allow any named approver):
RECOVERY_APPROVAL_TOKEN=
# Four-eyes rule: the approver must differ from the requester.
REQUIRE_DISTINCT_APPROVER=false
