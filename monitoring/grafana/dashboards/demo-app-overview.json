            "uid": "prometheus"
          },
          "expr": "sum(rate(http_requests_total{job=\"demo-app\", status=~\"5..\"}[2m])) / clamp_min(sum(rate(http_requests_total{job=\"demo-app\"}[2m])), 1e-9)",
          "legendFormat": ""
