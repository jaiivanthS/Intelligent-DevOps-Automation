# Copy to .env (git-ignored), or let ./setup.sh generate it.
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me
JENKINS_URL=http://localhost:8080/
GIT_REPO_URL=https://github.com/jaiivanthS/Intelligent-DevOps-Automation.git
DOCKER_GID=999

# Filled from /etc/devops-platform.env on the EC2 host; leave empty locally to skip the ECR push.
AWS_REGION=
ECR_REGISTRY=
ECR_REPOSITORY=

# Deployment target (private IP of the app host); empty = CI only, no deploy stages.
APP_HOST=
# URL the smoke tests call; empty = http://APP_HOST (local stack: http://demo-app:8000).
APP_URL=
# Platform API that receives pipeline/deploy events (step 6); empty = don't send.
PLATFORM_API_URL=
# Must equal INGEST_TOKEN in platform/.env if you set one there.
PLATFORM_INGEST_TOKEN=
