# Copy to terraform.tfvars (git-ignored) and fill in your values.

aws_region  = "ap-south-1"
environment = "dev"

# Your public IP with /32. Find it at https://checkip.amazonaws.com
admin_cidrs = ["203.0.113.10/32"]

# Contents of your public key file, e.g. ~/.ssh/id_ed25519.pub
ssh_public_key = "ssh-ed25519 AAAA... you@laptop"

# Optional overrides
# jenkins_instance_type = "t3.medium"
# app_instance_type     = "t3.medium"
# app_ingress_cidrs     = ["0.0.0.0/0"]   # who can open the demo app on port 80
# enable_ssm            = true
